{
  "name": "remote-desk-app",
  "productName": "Remote Desk",
  "version": "0.2.0-beta.3",
  "description": "Open-source remote desktop",
  "author": "remote-desk contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Molyn597/remote-desk.git"
  },
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.24",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@trystero-p2p/ws-relay": "^0.26.0",
    "@types/node": "^24.19.2",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "trystero": "^0.26.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "io.github.remotedesk",
    "productName": "Remote Desk",
    "artifactName": "Remote-Desk-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!**/node_modules/@jitsi/robotjs/{build,src,test}/**"
    ],
    "asarUnpack": [
      "**/node_modules/@jitsi/robotjs/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Remote Desk shares this computer's sound with the person you allowed to connect."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-win.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "protocols": [
      {
        "name": "Remote Desk",
        "schemes": [
          "remotedesk"
        ]
      }
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 130,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
